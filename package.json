{
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.12"
  },
  "name": "yieldvault-rwa",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "license-checker": "^25.0.1",
    "tsx": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "check:pnpm-version": "node scripts/check-pnpm-version.js",
    "prepare": "husky",
    "test": "vitest run",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "build:schemas": "npm --prefix packages/api-schemas run build",
    "build": "pnpm build:schemas && pnpm --filter backend build && pnpm --filter frontend build",
    "typecheck": "pnpm build:schemas && pnpm --filter backend typecheck && pnpm --filter frontend build",
    "dev": "concurrently \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "pnpm build:schemas && bash scripts/wait-for-db.sh && pnpm --filter backend dev",
    "dev:frontend": "pnpm build:schemas && pnpm --filter frontend dev",
    "wait-for-db": "bash scripts/wait-for-db.sh",
    "test": "pnpm --filter backend test -- --runInBand --coverage && pnpm --filter frontend test --run",
    "test:backend": "pnpm --filter backend test -- --runInBand --coverage",
    "test:frontend": "pnpm --filter frontend test --run",
    "test:root": "vitest run",
    "test:scripts": "vitest run",
    "test:all": "pnpm --filter backend test -- --runInBand --coverage && pnpm --filter frontend test --run && vitest run",
    "test:flaky": "pnpm --filter backend test:flaky",
    "test:flaky-detector": "pnpm --filter backend test:flaky-detector",
    "test:wait-for-db": "vitest run scripts/wait-for-db.test.ts",
    "validate:licenses": "tsx scripts/validate-licenses.ts",
    "test:validate-licenses": "vitest run scripts/validate-licenses.test.ts",
    "check:licenses": "pnpm validate:licenses && pnpm test:validate-licenses",
    "compress:images": "bash scripts/compress-pngs.sh",
    "validate:images": "tsx scripts/validate-image-sizes.ts",
    "test:validate-images": "vitest run scripts/validate-image-sizes.test.ts",
    "validate:line-endings": "tsx scripts/validate-generated-artifacts.ts",
    "test:validate-line-endings": "vitest run scripts/validate-generated-artifacts.test.ts",
    "clean:git-history": "bash scripts/purge-git-large-blobs.sh",
    "validate:frontend-env": "tsx scripts/validate-frontend-env.ts",
    "test:validate-frontend-env": "vitest run --config scripts/vitest.config.ts",
    "validate:contribution-standards": "tsx scripts/validate-contribution-standards.ts",
    "validate:testing-strategy": "tsx scripts/validate-testing-strategy.ts",
    "test:validate-workspace-test-scripts": "vitest run scripts/validate-workspace-test-scripts.test.ts",
    "validate:sprint-and-triage": "tsx scripts/validate-sprint-and-triage-conventions.ts",
    "validate:release-notes": "tsx scripts/validate-release-notes.ts",
    "validate:nfr-baselines": "tsx scripts/validate-nfr-baselines.ts",
    "validate:incident-severity": "tsx scripts/validate-incident-severity.ts",
    "validate:codeowners": "tsx scripts/validate-codeowners.ts",
    "test:validate-codeowners": "vitest run scripts/validate-codeowners.test.ts",
    "check:codeowners": "pnpm validate:codeowners && pnpm test:validate-codeowners",
    "validate:pr-template": "tsx scripts/validate-pr-template.ts",
    "test:validate-pr-template": "vitest run scripts/validate-pr-template.test.ts",
    "check:pr-template": "pnpm validate:pr-template && pnpm test:validate-pr-template",
    "validate:renovate": "tsx scripts/validate-renovate-config.ts",
    "test:validate-renovate": "vitest run scripts/validate-renovate-config.test.ts",
    "audit:pnpm": "pnpm audit --audit-level=high",
    "check:security-audit": "pnpm validate:renovate && pnpm test:validate-renovate && pnpm audit --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.17.21"
    }
  },
  "overrides": {
    "lodash": "^4.17.21"
  },
  "resolutions": {
    "lodash": "^4.17.21"
  },
  "lint-staged": {
    "{frontend,backend}/**/*.{ts,tsx}": "node scripts/lint-staged-runners.js eslint",
    "contracts/**/*.rs": "node scripts/lint-staged-runners.js rustfmt"
  }
}
